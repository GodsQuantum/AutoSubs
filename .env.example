# Host-facing port used by compose.example.yaml.
AUTOSUBS_HTTP_PORT=3051
PUID=1000
PGID=1000
TZ=UTC

# Host path mounted as /media. Change this to your media/NAS root.
MEDIA_PATH=./media

# Runtime concurrency.
AUTOSUBS_MAX_RENDER_JOBS=2
AUTOSUBS_MAX_TRANSCRIPTION_JOBS=2
AUTOSUBS_MAX_QUEUED_JOBS=256

# Optional first-boot transcription bootstrap. After the DB exists, Settings in the UI are authoritative.
AUTOSUBS_TRANSCRIPTION_LANGUAGE=fr
AUTOSUBS_TRANSCRIPTION_URL=
AUTOSUBS_TRANSCRIPTION_MODEL=
AUTOSUBS_TRANSCRIPTION_API_KEY=

AUTOSUBS_LOCAL_TRANSCRIPTION_ENABLED=false
AUTOSUBS_LOCAL_TRANSCRIPTION_URL=
AUTOSUBS_LOCAL_TRANSCRIPTION_MODEL=
AUTOSUBS_LOCAL_TRANSCRIPTION_API_KEY=
AUTOSUBS_LOCAL_FALLBACK_ENABLED=true
