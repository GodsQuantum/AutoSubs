{
  "name": "autosubs-frontend",
  "private": true,
  "version": "3.6.3",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "~6.0.3",
    "vite": "8.3.8"
  },
  "overrides": {
    "deepmerge": "4.1.1"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
