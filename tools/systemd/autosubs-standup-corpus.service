[Unit]
Description=AutoSubs stand-up corpus - aligned SRT/Markdown/FTS5 (Cloud9)
Documentation=https://github.com/GodsQuantum/AutoSubs/blob/main/tools/CORPUS.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=-/etc/autosubs/standup-corpus.env
ExecStart=/usr/bin/python3 -u /opt/autosubs/tools/standup_corpus.py run
Restart=on-failure
RestartSec=300s
Nice=12
CPUWeight=30
IOWeight=50
NoNewPrivileges=true
TimeoutStopSec=40s

[Install]
WantedBy=multi-user.target
